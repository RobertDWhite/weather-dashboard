# Optional: override the YAML config file path.
# WX_CONFIG=/etc/weather-dashboard/config.yaml

# Back-compat: single webhook URL if you don't want to use config.yaml webhooks.
# WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXX

# Any Settings field can also be overridden via env (matches its lowercase name).
# OBSERVER_LAT=39.5
# OBSERVER_LON=-84.5
# AIRNOW_KEY=...
# OPENWEATHERMAP_KEY=...
